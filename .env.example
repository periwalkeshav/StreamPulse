# Copy to .env and adjust. docker-compose reads this file automatically.

# ---- Kafka -----------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
RAW_TOPIC=raw-events
PROCESSED_TOPIC=processed-events
DLQ_TOPIC=dlq-events
ALERTS_TOPIC=alerts

# ---- Producer --------------------------------------------------------------
EVENTS_PER_SECOND=1000
DURATION_SECONDS=0          # 0 = run until stopped
MALFORMED_RATE=0.01         # share of poison pills, exercises the DLQ
ANOMALY_RATE=0.005          # share of >6 sigma values, exercises the detector
LATE_EVENT_RATE=0.01        # share of events emitted behind wall clock
KAFKA_BATCH_SIZE=65536
KAFKA_LINGER_MS=20
KAFKA_COMPRESSION=lz4
KAFKA_ACKS=1

# ---- Spark -----------------------------------------------------------------
SPARK_DRIVER_MEMORY=2g
SPARK_LOCAL_CORES=4
SHUFFLE_PARTITIONS=4
TRIGGER_INTERVAL=10 seconds
WINDOW_DURATION=5 minutes
WATERMARK_DELAY=10 minutes
SESSION_GAP=2 minutes
SESSION_WATERMARK=2 minutes
ANOMALY_SIGMA=3.0
STARTING_OFFSETS=latest

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=streampulse
POSTGRES_USER=streampulse
POSTGRES_PASSWORD=streampulse

# ---- DLQ monitor -----------------------------------------------------------
DLQ_REPORT_INTERVAL=60
DLQ_ALERT_THRESHOLD=100
